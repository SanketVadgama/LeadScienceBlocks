<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Care Team Section</title>
  <link rel="stylesheet" href="care-team-section.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- ========== CARE TEAM SECTION ========== -->
  <section class="care-team" id="doctors">
    <div class="care-team__inner">
      <div class="care-team__header">
        <p class="care-team__eyebrow">Care team</p>
        <h2 class="care-team__title">Board-certified. Quietly exceptional.</h2>
      </div>

      <div class="care-team__grid">
        <!-- Member 1 -->
        <div class="care-team__card" data-animate>
          <div class="staff-portrait" style="--staff-ring: #2e6be6">
            <img
              src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=600&q=80"
              alt="Dr. Amara Okafor"
              loading="lazy"
            />
            <span class="staff-ring"></span>
            <div class="staff-tag">
              <p class="staff-tag__role">Chief of Cardiology</p>
              <p class="staff-tag__cta">Book a visit →</p>
            </div>
          </div>
          <h3 class="care-team__name">Dr. Amara Okafor</h3>
          <p class="care-team__role">Chief of Cardiology</p>
        </div>

        <!-- Member 2 -->
        <div class="care-team__card" data-animate>
          <div class="staff-portrait" style="--staff-ring: #2e6be6">
            <img
              src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=600&q=80"
              alt="Dr. Liam Chen"
              loading="lazy"
            />
            <span class="staff-ring"></span>
            <div class="staff-tag">
              <p class="staff-tag__role">Primary Care</p>
              <p class="staff-tag__cta">Book a visit →</p>
            </div>
          </div>
          <h3 class="care-team__name">Dr. Liam Chen</h3>
          <p class="care-team__role">Primary Care</p>
        </div>

        <!-- Member 3 -->
        <div class="care-team__card" data-animate>
          <div class="staff-portrait" style="--staff-ring: #2e6be6">
            <img
              src="https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=600&q=80"
              alt="Dr. Sofia Reyes"
              loading="lazy"
            />
            <span class="staff-ring"></span>
            <div class="staff-tag">
              <p class="staff-tag__role">Pediatrics</p>
              <p class="staff-tag__cta">Book a visit →</p>
            </div>
          </div>
          <h3 class="care-team__name">Dr. Sofia Reyes</h3>
          <p class="care-team__role">Pediatrics</p>
        </div>

        <!-- Member 4 -->
        <div class="care-team__card" data-animate>
          <div class="staff-portrait" style="--staff-ring: #2e6be6">
            <img
              src="https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&w=600&q=80"
              alt="Dr. Nathan Park"
              loading="lazy"
            />
            <span class="staff-ring"></span>
            <div class="staff-tag">
              <p class="staff-tag__role">Dermatology</p>
              <p class="staff-tag__cta">Book a visit →</p>
            </div>
          </div>
          <h3 class="care-team__name">Dr. Nathan Park</h3>
          <p class="care-team__role">Dermatology</p>
        </div>
      </div>
    </div>
  </section>

  <script src="care-team-section.js"></script>
</body>
</html>
